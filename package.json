{
	"name": "blockparty-iframe",
	"version": "1.2.2",
	"description": "Add a block to display an embedded frame in the WordPress editor.",
	"author": "Be API Technical team",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"scripts": {
		"build": "wp-scripts build --blocks-manifest",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"make-pot": "wp i18n make-pot . languages/blockparty-iframe.pot --exclude=\"src\" --domain=blockparty-iframe",
		"make-json": "wp i18n make-json languages/blockparty-iframe-fr_FR.po languages/ --no-purge",
		"start": "wp-scripts start --blocks-manifest",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:start-tests": "wp-env start --xdebug=coverage --config=./.wp-env.test.json",
		"env:start-ci": "wp-env start --config=./.wp-env.test.json",
		"env:stop-tests": "wp-env stop --config=./.wp-env.test.json",
		"env:reset-tests": "wp-env destroy --config=./.wp-env.test.json --force && wp-env start --xdebug=coverage --config=./.wp-env.test.json",
		"env:cli-test": "wp-env run cli --config=./.wp-env.test.json",
		"test:php": "wp-env run cli --config=./.wp-env.test.json --env-cwd=wp-content/plugins/blockparty-iframe/ -- ./vendor/bin/phpunit",
		"test:unit:js": "wp-scripts test-unit-js",
		"test:e2e": "wp-scripts test-playwright --config tests/playwright/playwright.config.js",
		"test:e2e-debug": "wp-scripts test-playwright --headed --config tests/playwright/playwright.config.js",
		"test:e2e-ui": "wp-scripts test-playwright --ui --config tests/playwright/playwright.config.js"
	},
	"devDependencies": {
		"@playwright/test": "^1.58.2",
		"@wordpress/e2e-test-utils-playwright": "^1.54.0",
		"@wordpress/env": "^12.1.0",
		"@wordpress/scripts": "^31.8.0",
		"@wordpress/url": "^4.37.0",
		"lodash": "^4.17.21"
	},
	"dependencies": {
		"@wordpress/block-editor": "15.17.0",
		"@wordpress/blocks": "15.17.0",
		"@wordpress/components": "32.6.0",
		"@wordpress/element": "6.44.0",
		"@wordpress/i18n": "6.17.0",
		"@wordpress/icons": "^12.2.0",
		"@wordpress/server-side-render": "6.20.0"
	},
	"volta": {
		"node": "24.15.0"
	}
}
